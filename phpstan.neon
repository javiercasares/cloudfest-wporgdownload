includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - cloudfest-wporgdownload.php
        - includes/
        - uninstall.php
    excludePaths:
        - tests/*
    bootstrapFiles:
        - tests/bootstrap.php
    ignoreErrors:
        # PHPDoc @var tags on define() constants don't need variable names
        - '#PHPDoc tag @var does not specify variable name#'
    scanDirectories:
        - vendor/
    scanFiles: []
    treatPhpDocTypesAsCertain: false
