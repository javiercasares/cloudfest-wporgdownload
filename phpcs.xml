<?xml version="1.0"?>
<ruleset name="CloudFest WPOrgDownload">
    <description>WordPress Coding Standards for CloudFest WPOrg Download Plugin</description>

    <!-- What to scan -->
    <file>.</file>

    <!-- Exclude paths -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>

    <!-- Show progress and sniff codes -->
    <arg value="ps"/>

    <!-- Colors -->
    <arg name="colors"/>

    <!-- Use WordPress coding standards -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <!-- PHP version compatibility -->
    <config name="testVersion" value="8.4-"/>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="cloudfest-wporgdownload"/>
            </property>
        </properties>
    </rule>

    <!-- Allow short array syntax (disable universal sniff) -->
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Arrays.DisallowShortArraySyntax">
        <severity>0</severity>
    </rule>

    <!-- Enforce short array syntax -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
</ruleset>
